{
  "name": "@wikitraveler/www",
  "version": "0.5.2",
  "private": true,
  "scripts": {
    "copy-assets": "node scripts/copy-public-assets.mjs",
    "dev": "node scripts/copy-public-assets.mjs && pnpm exec next dev -p 3002",
    "build": "node scripts/copy-public-assets.mjs && pnpm exec next build",

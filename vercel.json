{
  "version": 2,
  "ignoreCommand": "bash -c '[[ \"$VERCEL_GIT_COMMIT_REF\" == dependabot/* ]]'",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run vercel-build",
  "builds": [
    {
      "src": "apps/node/next.config.js",
      "use": "@vercel/next"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/gossip",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/ai-scan",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/wheelmap-sync",
      "schedule": "0 3 * * *"
    }
  ]
}
